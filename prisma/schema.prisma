generator client {
  provider = "prisma-client-js"
}






datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  CLIENT
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  galleries     Gallery[]
}

model Package {
  id              String    @id @default(cuid())
  name            String
  description     String
  price           Float
  depositAmount   Float
  duration        Int       // in minutes
  includedPhotos  Int
  deliveryDays    Int
  features        String[]
  category        String    // Wedding, Portrait, etc.
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  packageId       String
  package         Package       @relation(fields: [packageId], references: [id])
  date            DateTime
  startTime       String        // HH:mm
  endTime         String        // HH:mm
  status          BookingStatus @default(PENDING)
  location        String?
  notes           String?
  inspirationImgs String[]      // URLs
  totalAmount     Float
  paidAmount      Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payment         Payment?
}

model Gallery {
  id          String         @id @default(cuid())
  name        String
  description String?
  slug        String         @unique
  category    String
  isPrivate   Boolean        @default(false)
  password    String?
  clientId    String?
  client      User?          @relation(fields: [clientId], references: [id])
  coverImage  String
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  width     Int?
  height    Int?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  content     String
  rating      Int      @default(5)
  image       String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // Markdown
  excerpt     String
  coverImage  String
  category    String
  author      String
  tags        String[]
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED
  createdAt DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  stripeId      String   @unique
  amount        Float
  currency      String   @default("USD")
  status        String
  createdAt     DateTime @default(now())
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0-6
  startTime String   // HH:mm
  endTime   String   // HH:mm
  isBlocked Boolean  @default(false)
  specificDate DateTime? // Optional for specific date blocks
}
model PortfolioItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  url       String
  status    String   @default("Published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
